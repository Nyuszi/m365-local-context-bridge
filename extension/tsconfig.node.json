{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vite.config.background.ts",
    "vite.config.content.ts",
    "vitest.config.ts"
  ]
}
